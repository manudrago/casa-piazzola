# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and fill it in. Nothing here belongs in git.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL, no trailing slash. Used for canonical URLs, Open Graph
# images, Stripe redirects and the links in confirmation emails — get it wrong
# and guests are redirected to the wrong place after paying.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Database ────────────────────────────────────────────────────────────────
# SQLite for local work. For production switch the `provider` in
# prisma/schema.prisma to "postgresql" and put your connection string here.
DATABASE_URL="file:./dev.db"

# ── Stripe ──────────────────────────────────────────────────────────────────
# Test keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY="sk_test_..."

# From `stripe listen --forward-to localhost:3000/api/stripe/webhook`, or from
# the webhook endpoint you create in the Stripe dashboard for production.
# THE SITE WILL TAKE MONEY WITHOUT THIS, BUT WILL NEVER CONFIRM THE BOOKING.
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Email (Resend) ──────────────────────────────────────────────────────────
# https://resend.com — the sending domain must be verified before real sends.
RESEND_API_KEY="re_..."
EMAIL_FROM="Casa Piazzola <hello@yourdomain.com>"

# Where booking alerts and guest messages land. Also the Reply-To on every
# email sent to guests.
HOST_EMAIL="you@yourdomain.com"

# ── Host dashboard ──────────────────────────────────────────────────────────
# The password you type at /admin.
ADMIN_PASSWORD="choose-something-long"

# Signs the admin session cookie. Any random string of 32+ characters.
# Generate one with:  openssl rand -base64 32
# Changing it signs everyone out immediately.
ADMIN_SESSION_SECRET="replace-me-with-32-random-characters"
